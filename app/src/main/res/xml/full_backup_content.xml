<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 counterpart of data_extraction_rules.xml. Backup is already disabled through
  android:allowBackup="false", so this only guarantees that no scan, database or preference leaves
  the device if a future build ever opts back in.
-->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
