<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background. The gradient stops match the blue of Docs/VCCScannere.png and
     startY/endY align it with the 76dp artwork that ic_launcher_foreground places at 16..92dp,
     so the corners the system mask trims off keep the same tone as the artwork next to them. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="16"
                android:endX="0"
                android:endY="92"
                android:startColor="#2593FF"
                android:endColor="#00185E"
                android:tileMode="clamp" />
        </aapt:attr>
    </path>
</vector>
